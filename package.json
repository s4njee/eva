{
  "name": "eva",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:submodules": "npm --prefix visualizations/monolith install && npm --prefix visualizations/matrix install && npm --prefix visualizations/atom install && npm --prefix visualizations/bocchi install && npm --prefix visualizations/planes install",
    "install:all": "npm install && npm run install:submodules",
    "dev": "npm run dev:root",
    "dev:root": "vite",
    "dev:monolith": "npm --prefix visualizations/monolith run dev",
    "dev:matrix": "npm --prefix visualizations/matrix run dev",
    "dev:atom": "npm --prefix visualizations/atom run dev",
    "dev:bocchi": "npm --prefix visualizations/bocchi run dev",
    "dev:planes": "npm --prefix visualizations/planes run dev",
    "build": "npm run build:root",
    "build:root": "vite build",
    "build:monolith": "npm --prefix visualizations/monolith run build",
    "build:matrix": "npm --prefix visualizations/matrix run build",
    "build:atom": "npm --prefix visualizations/atom run build",
    "build:bocchi": "npm --prefix visualizations/bocchi run build",
    "build:planes": "npm --prefix visualizations/planes run build",
    "build:all": "npm run build:root && npm run build:monolith && npm run build:matrix && npm run build:atom && npm run build:bocchi && npm run build:planes",
    "lint:matrix": "npm --prefix visualizations/matrix run lint",
    "check:matrix-visible": "node scripts/check-matrix-visibility.mjs",
    "check": "npm run build:root && npm run build:monolith && npm run build:matrix && npm run lint:matrix && npm run build:atom && npm run build:bocchi && npm run build:planes",
    "preview": "npm run preview:root",
    "preview:root": "vite preview",
    "preview:pages": "npm run build:root && wrangler pages dev dist",
    "preview:monolith": "npm --prefix visualizations/monolith run preview",
    "preview:matrix": "npm --prefix visualizations/matrix run preview",
    "preview:atom": "npm --prefix visualizations/atom run preview",
    "preview:bocchi": "npm --prefix visualizations/bocchi run preview",
    "preview:planes": "npm --prefix visualizations/planes run preview",
    "deploy:pages": "./deploy-pages.sh"
  },
  "devDependencies": {
    "@gltf-transform/extensions": "^4.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "gltf-pipeline": "^4.3.1",
    "playwright": "^1.58.2",
    "vite": "^7.2.4",
    "wrangler": "^4.83.0"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.4.15",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@takram/three-atmosphere": "^0.18.0",
    "@takram/three-clouds": "^0.7.4",
    "@takram/three-geospatial": "^0.8.0",
    "@takram/three-geospatial-effects": "^0.6.2",
    "lil-gui": "^0.21.0",
    "maplibre-gl": "^5.23.0",
    "postprocessing": "^6.36.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.0",
    "scheduler": "^0.27.0",
    "three": "^0.184.0",
    "troika-three-text": "^0.52.4"
  }
}
